{
  "manifest_version": 3,
  "name": "Anchor",
  "version": "1.3.5",
  "icons": {
      "128": "icon.png"
  },
  "content_scripts": [
  {
    "matches": [
      "<all_urls>"
     ],
     "js": ["jquery-3.2.1.js", "content.js"],
     "css":        ["main.css"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
